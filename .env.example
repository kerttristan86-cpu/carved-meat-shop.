DATABASE_DIR=./data/production
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
# Hosted mode: when DATABASE_URL is set, DATABASE_DIR is ignored. Use the transaction pooler URL.
# DATABASE_URL=
# Certificate that verifies the database connection: file path locally, PEM text when hosted.
# DATABASE_CA_FILE=./supabase-ca.crt
# DATABASE_CA_PEM=
